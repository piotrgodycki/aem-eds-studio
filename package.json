{
	"name": "aem-eds-studio",
	"version": "0.4.4",
	"private": true,
	"description": "The desktop studio for aem-eds-kit: developers, managers and clients turn designs into AEM Edge Delivery blocks, review them in rounds and accept them into the repository. Ships as .dmg/.exe, not on npm.",
	"type": "module",
	"license": "MIT",
	"author": "Piotr Godycki",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/piotrgodycki/aem-eds-studio.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "vite build && tsc -p tsconfig.server.json",
		"start": "node dist/server/cli.js",
		"dev:server": "tsx watch src/server/cli.ts --no-open",
		"dev:web": "vite",
		"lint": "biome check src tests",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"desktop": "npm run build && electron .",
		"dist:mac": "npm run build && electron-builder --mac",
		"dist:win": "npm run build && electron-builder --win",
		"dist:linux": "npm run build && electron-builder --linux"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.6",
		"aem-eds-kit": "^0.4.79",
		"electron-updater": "^6.8.11",
		"hono": "^4.13.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/geist-sans": "^5.3.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^6.3.0",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tsx": "^4.19.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"main": "dist/desktop/main.js",
	"build": {
		"appId": "com.piotrgodycki.aemedsstudio",
		"productName": "AEM EDS Studio",
		"artifactName": "AEM-EDS-Studio-${os}-${arch}.${ext}",
		"asar": false,
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"dist/**",
			"package.json"
		],
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64",
						"x64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"arm64",
						"x64"
					]
				}
			],
			"category": "public.app-category.developer-tools"
		},
		"dmg": {
			"title": "AEM EDS Studio ${version}"
		},
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"perMachine": false
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development"
		},
		"publish": [
			{
				"provider": "github",
				"owner": "piotrgodycki",
				"repo": "aem-eds-studio"
			}
		]
	}
}
